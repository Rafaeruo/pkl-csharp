amends "pkl:Project"

package {
  name = "pkl-csharp"
  // The package metadata is fetched from the HTTPS URL derived from `baseUri@version`, so it has to be
  // published at exactly that location: the files `pkl project package` creates are attached to the GitHub
  // release tagged `<version>` (see pack-pkl.sh). Keep `version` equal to `VersionPrefix` in Directory.Build.props.
  baseUri = "package://github.com/Rafaeruo/pkl-csharp/releases/download/\(version)/pkl-csharp"
  version = "0.5.0"
  packageZipUrl = "https://github.com/Rafaeruo/pkl-csharp/releases/download/\(version)/pkl-csharp@\(version).zip"
  description = "Annotations for the pkl-csharp code generator (PklCsharp.Generator)."
  sourceCode = "https://github.com/Rafaeruo/pkl-csharp"
  sourceCodeUrlScheme = "https://github.com/Rafaeruo/pkl-csharp/blob/\(version)/PklPackage%{path}#L%{line}-L%{endLine}"
  issueTracker = "https://github.com/Rafaeruo/pkl-csharp/issues"
  license = "Apache-2.0"
}
