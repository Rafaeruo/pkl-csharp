<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Pkl\Pkl.csproj" />
    <!-- In your own project, reference the PklCsharp.Generator NuGet package instead. -->
    <ProjectReference Include="..\..\PklGenerator\PklGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Config\Pkl\Schema\*.pkl" PklGenerator_Generate="true" PklGenerator_Namespace="Pkl.ConsoleAppExample.Config" />
  </ItemGroup>

  <!-- Normally supplied by the PklCsharp.Generator package. -->
  <Import Project="..\..\PklGenerator\PklGenerator.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Config\Pkl\**\*.pkl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>  
  </ItemGroup>
</Project>
